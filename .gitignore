# ============================================================
# 金融知识库 · Git 忽略清单
# 规则：凡是"含密钥、体积大、可再生成"的文件都不进仓库
# ============================================================

# ---------- ★★★ 密钥与配置（最高优先级，绝对不能提交）----------
.env
.env.local
.env.*.local
*.key
*.pem

# 但示例配置模板要保留（只有键名、没有值）
!.env.example

# ---------- Python 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.pyc

# ---------- 虚拟环境（体积大，可用 uv sync 重装）----------
.venv/
venv/
ENV/
env/
.conda/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.iml
*.swp
*.swo

# ---------- 运行时产物（每次运行都会变，不该进版本库）----------
logs/
*.log
output/
temp/
tmp/

# ---------- 模型与向量文件（体积大，从网上下载）----------
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.gguf

# ---------- 操作系统临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
